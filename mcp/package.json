{
  "name": "mistwarden-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server that lets a coding assistant build scenes in a Mistwarden campaign as its GM",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "login": "node bin/login",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node test/integration.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "fsevents": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.11",
    "eslint": "10.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "^5.1.2"
  }
}
